#!name=Apple WLOC 定位修改
#!desc=修改 Apple 网络定位(Wi-Fi/基站)返回坐标 | 苹果地图选点+快捷指令直接生效, 全程设备内 | 用法见 GitHub
#!author=bgtendtofree
#!homepage=https://github.com/bgtendtofree/wloc

[Script]
Apple WLOC = type=http-response,pattern=^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com)\/clls\/wloc,requires-body=true,binary-body-mode=true,engine=jsc,debug=true,script-path=https://raw.githubusercontent.com/bgtendtofree/wloc/refs/heads/main/dist/surge/wloc.js,argument=accuracy=25&logLevel=info,script-update-interval=86400
WLOC Settings = type=http-request,pattern=^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save,engine=jsc,debug=true,script-path=https://raw.githubusercontent.com/bgtendtofree/wloc/refs/heads/main/dist/surge/wloc-settings.js,script-update-interval=86400

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com
